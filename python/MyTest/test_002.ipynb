     "text": [
      "캐릭터 데이터 오류 : -----HP는 음수가 될 수 없습니다.\n"
     ]
    }
   ],
   "source": [
    "def set_hp(hp):\n",
    "    if hp < 0:\n",
    "        raise ValueError(\"-----HP는 음수가 될 수 없습니다.\")\n",
    "\n",
    "    return hp\n",
    "\n",
    "\n",
    "try:\n",
    "    hp = set_hp(-10)\n",
    "    print(hp)\n",
    "\n",
    "except ValueError as e:\n",
    "    print(f\"캐릭터 데이터 오류 : {e}\")"
   ]
  }
 ],
